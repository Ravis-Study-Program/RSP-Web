    "@mantine/hooks": "^8.2.4",
    "@mantine/modals": "^8.2.4",
    "@mantine/notifications": "^8.2.4",
    "@mantine/spotlight": "^8.2.4",
    "@mantine/tiptap": "^8.2.4",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.56.2",
    "@tiptap/core": "^3.5.3",
    "@tiptap/extension-character-count": "^3.6.1",
    "@tiptap/extension-highlight": "^3.5.3",
    "@tiptap/extension-link": "^3.5.3",
    "@tiptap/extension-subscript": "^3.5.3",
    "@tiptap/extension-superscript": "^3.5.3",
    "@tiptap/extension-text-align": "^3.5.3",
