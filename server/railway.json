{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./server/Dockerfile"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "dotnet RSPWebAPI.dll",
    "sleepApplication": false,
    "restartPolicyType": "ALWAYS"
  }
}
